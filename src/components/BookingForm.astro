---
// Formulario de datos personales + Turnstile.
// Se muestra cuando el usuario ha seleccionado fecha y hora.
export interface Props {
  serviceId: number;
  fecha: string;
  hora: string;
  turnstileSiteKey: string;
}

const { serviceId, fecha, hora, turnstileSiteKey } = Astro.props;
---

<form id="booking-form" class="w-full max-w-md mx-auto space-y-5" method="POST">
  <input type="hidden" name="serviceId" value={serviceId} />
  <input type="hidden" name="fecha" value={fecha} />
  <input type="hidden" name="hora_inicio" value={hora} />

  <!-- Nombre -->
  <div>
    <label for="nombre" class="block text-sm font-medium text-ink/70 mb-1">
      Nombre *
    </label>
    <input
      type="text"
      id="nombre"
      name="nombre"
      required
      autocomplete="name"
      class="w-full px-4 py-2.5 bg-bg border border-primary/20 rounded-xl text-ink
             focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20
             transition-colors placeholder:text-ink/30"
      placeholder="Tu nombre completo"
    />
  </div>

  <!-- Email -->
  <div>
    <label for="email" class="block text-sm font-medium text-ink/70 mb-1">
      Email *
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      autocomplete="email"
      class="w-full px-4 py-2.5 bg-bg border border-primary/20 rounded-xl text-ink
             focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20
             transition-colors placeholder:text-ink/30"
      placeholder="tu@email.com"
    />
  </div>

  <!-- Teléfono -->
  <div>
    <label for="telefono" class="block text-sm font-medium text-ink/70 mb-1">
      Teléfono *
    </label>
    <input
      type="tel"
      id="telefono"
      name="telefono"
      required
      autocomplete="tel"
      class="w-full px-4 py-2.5 bg-bg border border-primary/20 rounded-xl text-ink
             focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20
             transition-colors placeholder:text-ink/30"
      placeholder="+34 6XX XXX XXX"
    />
  </div>

  <!-- Mensaje -->
  <div>
    <label for="mensaje" class="block text-sm font-medium text-ink/70 mb-1">
      Mensaje <span class="text-ink/30">(opcional)</span>
    </label>
    <textarea
      id="mensaje"
      name="mensaje"
      rows={3}
      class="w-full px-4 py-2.5 bg-bg border border-primary/20 rounded-xl text-ink
             focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20
             transition-colors placeholder:text-ink/30 resize-none"
      placeholder="¿Algo que quieras comentar?"
    ></textarea>
  </div>

  <!-- Turnstile -->
  <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>
  <input type="hidden" name="turnstileToken" id="turnstile-token" />

  <!-- Error / estado -->
  <div id="form-error" class="hidden text-sm rounded-xl px-4 py-2" style="color: var(--color-error-text); background-color: var(--color-error-bg)"></div>

  <!-- Submit -->
  <button
    type="submit"
    id="form-submit"
    class="btn-primary w-full text-center disabled:opacity-50 disabled:cursor-not-allowed"
    disabled
  >
    Enviar solicitud
  </button>
</form>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const submitBtn = document.getElementById('form-submit') as HTMLButtonElement;
  const errorDiv = document.getElementById('form-error') as HTMLDivElement;
  const turnstileTokenInput = document.getElementById('turnstile-token') as HTMLInputElement;

  // Callback cuando Turnstile se completa
  (window as any).onTurnstileCallback = function(token: string) {
    turnstileTokenInput.value = token;
    submitBtn.disabled = false;
  };

  // Callback cuando Turnstile expira
  (window as any).onTurnstileExpired = function() {
    turnstileTokenInput.value = '';
    submitBtn.disabled = true;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';

    const formData = new FormData(form);
    const data: Record<string, any> = {};
    formData.forEach((v, k) => { data[k] = v; });
    data.serviceId = Number(data.serviceId);

    try {
      const res = await fetch('/_actions/createBooking', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await res.json();

      if (!res.ok || result.error) {
        const msg = result.error?.message || 'Error al procesar la reserva. Inténtalo de nuevo.';
        errorDiv.textContent = msg;
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar solicitud';
        // Reset Turnstile si hubo error
        if (typeof turnstile !== 'undefined') {
          turnstile.reset();
        }
        turnstileTokenInput.value = '';
        return;
      }

      // Éxito → redirigir a /gracias
      window.location.href = '/gracias';
    } catch (_err) {
      errorDiv.textContent = 'Error de conexión. Revisa tu internet e inténtalo de nuevo.';
      errorDiv.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar solicitud';
    }
  });
</script>
