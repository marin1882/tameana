---
export interface Props {
  size?: 'sm' | 'lg';
  animated?: boolean;
}

const { size = 'lg', animated = false } = Astro.props;

const dimensions = size === 'sm'
  ? 'w-8 h-8'
  : 'w-48 h-48 md:w-64 md:h-64';
---

<!-- TODO: sustituir SVG placeholder por el logo real -->

<svg
  class:list={[dimensions, { 'logo-breathing': animated }]}
  viewBox="0 0 200 200"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Círculo exterior -->
  <circle cx="100" cy="100" r="90" stroke="var(--color-primary)" stroke-width="3" fill="none" />
  <!-- Forma orgánica interior — placeholder abstracto -->
  <path
    d="M60 100 C60 60, 140 60, 140 100 C140 140, 100 150, 100 120 C100 90, 80 90, 80 100 C80 120, 100 130, 100 130"
    stroke="var(--color-primary)"
    stroke-width="3"
    fill="var(--color-accent-soft)"
    fill-opacity="0.4"
    stroke-linecap="round"
  />
  <!-- Punto central -->
  <circle cx="100" cy="108" r="6" fill="var(--color-primary)" />
</svg>
