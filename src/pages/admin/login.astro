---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createAdminCookie } from '../../lib/auth';
import { env } from 'cloudflare:workers';

export const prerender = false;

let error = '';

// Procesar login (POST con form data)
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const password = formData.get('password')?.toString() || '';
  const adminPassword = env.ADMIN_PASSWORD || 'tameana-admin-2026';

  const cookie = await createAdminCookie(password, adminPassword);

  if (cookie) {
    const redir = Astro.url.searchParams.get('redirect') || '/admin';
    return new Response(null, {
      status: 302,
      headers: {
        Location: redir,
        'Set-Cookie': cookie,
      },
    });
  } else {
    error = 'Contraseña incorrecta.';
  }
}

const redirect = Astro.url.searchParams.get('redirect') || '/admin';
---

<BaseLayout
  title="Admin — Acceso"
  description="Acceso al panel de administración de Tameana"
>
  <div class="min-h-[80vh] flex items-center justify-center">
    <form method="POST" class="w-full max-w-sm mx-auto space-y-6 bg-surface rounded-2xl p-8 shadow-sm">
      <div class="text-center">
        <h1 class="font-serif text-2xl text-ink">Acceso</h1>
        <p class="text-ink/50 text-sm mt-1">Panel de administración</p>
      </div>

      {error && (
        <div style="background: var(--color-error-bg); color: var(--color-error-text);" class="text-sm rounded-xl px-4 py-2 text-center">
          {error}
        </div>
      )}

      <div>
        <label for="password" class="block text-sm font-medium text-ink/70 mb-1">
          Contraseña
        </label>
        <input
          type="password"
          id="password"
          name="password"
          required
          autofocus
          class="w-full px-4 py-2.5 bg-bg border border-primary/20 rounded-xl text-ink
                 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20
                 transition-colors placeholder:text-ink/30"
          placeholder="••••••••"
        />
      </div>

      <input type="hidden" name="redirect" value={redirect} />

      <button type="submit" class="btn-primary w-full text-center">
        Entrar
      </button>

      <p class="text-center text-xs text-ink/30">
        <a href="/inicio" class="hover:text-primary transition-colors">&larr; Volver al inicio</a>
      </p>
    </form>
  </div>
</BaseLayout>
