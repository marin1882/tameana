---
// Paso intermedio: elegir modalidad (presencial / online) antes del calendario.
import PageLayout from '../../layouts/PageLayout.astro';
import DrawnIcon from '../../components/DrawnIcon.astro';

export const prerender = false;

const servicio = Astro.url.searchParams.get('servicio');

// Sin servicio, redirigir a /tameana
if (!servicio) {
  return Astro.redirect('/tameana');
}

// Mapeo de slugs a nombres legibles
const nombres: Record<string, string> = {
  adultos: 'Tameana para adultos',
  ninos: 'Tameana para niños',
  espacios: 'Hama Ambientes',
  grupal: 'Tameana grupal',
  animales: 'Tameana para animales',
  acompanamiento: 'Acompañamiento',
};

const nombreServicio = nombres[servicio] || servicio;
---

<PageLayout
  title="Elige la modalidad"
  description="Elige si prefieres una sesión presencial u online."
>
  <div class="max-w-2xl mx-auto space-y-10">
    <div class="text-center space-y-3">
      <h1 class="font-serif text-3xl md:text-4xl text-ink">¿Cómo prefieres la sesión?</h1>

      <!-- Resumen compacto del servicio ya elegido -->
      <div id="service-summary" class="inline-flex items-center gap-2 bg-surface rounded-xl px-5 py-2.5">
        <span class="font-serif text-ink font-medium">{nombreServicio}</span>
        <span class="text-ink/30">·</span>
        <span class="text-ink/50 text-sm">60 min</span>
        <a href="/tameana" class="text-xs text-primary hover:text-ink transition-colors ml-2">
          cambiar
        </a>
      </div>
    </div>

    <!-- Tarjetas de modalidad -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-lg mx-auto">
      <a
        href={`/reservar?servicio=${servicio}&modalidad=presencial`}
        class="flex flex-col items-center gap-4 p-8 rounded-2xl transition-all duration-300
               bg-surface hover:bg-surface hover:scale-105 shadow-sm hover:shadow-md group"
      >
        <DrawnIcon name="presencial" size="xl" class="text-primary transition-transform duration-300 group-hover:scale-110" />
        <span class="font-serif text-xl font-medium text-ink">Presencial</span>
        <span class="text-sm text-ink/50 text-center">En el espacio físico de la terapeuta</span>
      </a>

      <a
        href={`/reservar?servicio=${servicio}&modalidad=online`}
        class="flex flex-col items-center gap-4 p-8 rounded-2xl transition-all duration-300
               bg-surface hover:bg-surface hover:scale-105 shadow-sm hover:shadow-md group"
      >
        <DrawnIcon name="online" size="xl" class="text-primary transition-transform duration-300 group-hover:scale-110" />
        <span class="font-serif text-xl font-medium text-ink">Online</span>
        <span class="text-sm text-ink/50 text-center">Videollamada desde donde estés</span>
      </a>
    </div>
  </div>
</PageLayout>
