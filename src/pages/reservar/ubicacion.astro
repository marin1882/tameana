---
// Paso intermedio (solo presencial): elegir ubicación — Barcelona u otras localidades.
import PageLayout from '../../layouts/PageLayout.astro';
import DrawnIcon from '../../components/DrawnIcon.astro';

export const prerender = false;

const servicio = Astro.url.searchParams.get('servicio');
const modalidad = Astro.url.searchParams.get('modalidad');

// Sin servicio, redirigir a /tameana
if (!servicio) {
  return Astro.redirect('/tameana');
}

// Si modalidad no es presencial, redirigir directo al calendario online
if (modalidad !== 'presencial') {
  return Astro.redirect(`/reservar?servicio=${servicio}&modalidad=online`);
}

const nombres: Record<string, string> = {
  adultos: 'Tameana para adultos',
  ninos: 'Tameana para niños',
  espacios: 'Hama Ambientes',
  grupal: 'Tameana grupal',
  animales: 'Tameana para animales',
  acompanamiento: 'Acompañamiento',
};

const nombreServicio = nombres[servicio] || servicio;
---

<PageLayout
  title="Elige la ubicación"
  description="Elige si la sesión es en Barcelona o en otra localidad."
>
  <div class="max-w-2xl mx-auto space-y-10">
    <div class="text-center space-y-3">
      <h1 class="font-serif text-3xl md:text-4xl text-ink">¿Dónde prefieres la sesión?</h1>

      <!-- Resumen compacto -->
      <div class="inline-flex items-center gap-2 bg-surface rounded-xl px-5 py-2.5">
        <span class="font-serif text-ink font-medium">{nombreServicio}</span>
        <span class="text-ink/30">·</span>
        <span class="text-ink/50 text-sm">Presencial</span>
        <a href={`/reservar/modalidad?servicio=${servicio}`} class="text-xs text-primary hover:text-ink transition-colors ml-2">
          cambiar
        </a>
      </div>
    </div>

    <!-- Tarjetas de ubicación -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-lg mx-auto">
      <a
        href={`/reservar?servicio=${servicio}&modalidad=presencial`}
        class="flex flex-col items-center gap-4 p-8 rounded-2xl transition-all duration-300
               bg-surface hover:bg-surface hover:scale-105 shadow-sm hover:shadow-md group"
      >
        <DrawnIcon name="presencial" size="xl" class="text-primary transition-transform duration-300 group-hover:scale-110" />
        <span class="font-serif text-xl font-medium text-ink">Barcelona</span>
        <span class="text-sm text-ink/50 text-center">En el espacio de la terapeuta</span>
      </a>

      <a
        href={`/reservar/contacto?servicio=${servicio}`}
        class="flex flex-col items-center gap-4 p-8 rounded-2xl transition-all duration-300
               bg-surface hover:bg-surface hover:scale-105 shadow-sm hover:shadow-md group"
      >
        <DrawnIcon name="contacto" size="xl" class="text-primary transition-transform duration-300 group-hover:scale-110" />
        <span class="font-serif text-xl font-medium text-ink">Otras localidades</span>
        <span class="text-sm text-ink/50 text-center">Consúltanos y te informamos</span>
      </a>
    </div>
  </div>
</PageLayout>
